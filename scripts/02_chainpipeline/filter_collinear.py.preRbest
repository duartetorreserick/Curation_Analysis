#!/usr/bin/env python3
"""
Reciprocal-syntenic intersection + collinearity split, with unloc handling.

Takes the target-side and query-side syntenic net chains and keeps only the
chains present in BOTH (reciprocal 1x coverage on target and query), then
splits the survivors:

  minus strand                       -> non-collinear (inversion)
  plus strand, target out of order   -> non-collinear (transposition)
  plus strand, target in order       -> collinear

Chains are matched across the two files by chain id (field 13 of the header),
which chainSwap / chainSort / netChainSubset all preserve.

UNLOCS
------
Unlocalized scaffolds are not part of the curated chromosome structure, so
they are never collinear.  They arrive via --unloc-chain as their own rbest
set (built in isolation, so they never compete with the SUPERs in chainNet)
and are appended to the non-collinear output.

They cannot be classified by the strand/order rule above: that rule runs
per (target, query) pair, and an unloc is its own query sequence, so the
first chain of every unloc always looks "in order" and would be labelled
collinear.  The label is therefore assigned unconditionally.

Optionally, unloc chains whose T2T target is ALREADY covered by the SUPERs
classified here (duplications / alternative haplotype rather than sequence
missing from the chromosome) are diverted to --unloc-claimed-out instead.
Without that flag EVERY unloc chain goes to the non-collinear output.

Usage:
  filter_collinear.py TARGET_SYN_CHAIN QUERY_SYN_CHAIN OUT_COLLINEAR OUT_NONCOLLINEAR
                      [--unloc-chain FILE]
                      [--unloc-claimed-out FILE]
                      [--max-claim-overlap FLOAT]

Chain header fields (0-indexed):
  0 'chain'  1 score  2 tName  3 tSize  4 tStrand  5 tStart  6 tEnd
  7 qName    8 qSize  9 qStrand 10 qStart 11 qEnd  12 id
"""

import argparse
import sys
from collections import defaultdict


def read_chains(path):
    """Yield (header, block_lines) for each chain record in a chain file."""
    header, block = None, []
    with open(path) as fh:
        for line in fh:
            if line.startswith('chain'):
                if header is not None:
                    yield header, block
                header, block = line.rstrip('\n'), []
            elif line.strip():
                block.append(line)
    if header is not None:
        yield header, block


def chain_id(fields, path):
    if len(fields) < 13:
        sys.exit(f'ERROR: chain header without id field in {path}: '
                 f'{" ".join(fields)}')
    return fields[12]


def chain_ids(path):
    return {chain_id(h.split(), path) for h, _ in read_chains(path)}


def merge_intervals(intervals):
    """Merge overlapping/abutting (start, end) intervals."""
    if not intervals:
        return []
    intervals.sort()
    merged = [list(intervals[0])]
    for s, e in intervals[1:]:
        if s <= merged[-1][1]:
            if e > merged[-1][1]:
                merged[-1][1] = e
        else:
            merged.append([s, e])
    return [(s, e) for s, e in merged]


def total_overlap(t_start, t_end, sorted_intervals):
    """Overlap between [t_start, t_end) and a sorted, merged interval list."""
    total = 0
    for cs, ce in sorted_intervals:
        if ce <= t_start:
            continue
        if cs >= t_end:
            break
        total += min(ce, t_end) - max(cs, t_start)
    return total


def collinear_subset(chain_list):
    """
    Indices of the highest-scoring set of chains that runs forward on both axes.

    chain_list is already sorted by qStart, so the query axis is monotone by
    construction and only the target axis has to be checked. Minus-strand
    chains are inversions and can never join the set.

    A greedy walk was wrong here: it accepted whichever chain came first in
    query order, so on Mat_chr32 an 83 kb chain claimed the collinear label and
    forced the 4.8 Mb chain covering the same region to be called a
    transposition. Maximising total score picks the dominant thread instead.
    """
    n = len(chain_list)
    best = [-1] * n          # best total score of a run ending at i
    prev = [-1] * n
    for i in range(n):
        fi = chain_list[i][1].split()
        if fi[9] == '-':
            continue         # inversion: never collinear
        score_i, t_start = int(fi[1]), int(fi[5])
        best[i] = score_i
        for j in range(i):
            if best[j] < 0:
                continue
            if int(chain_list[j][1].split()[6]) <= t_start and best[j] + score_i > best[i]:
                best[i] = best[j] + score_i
                prev[i] = j

    end = max(range(n), key=lambda i: best[i]) if n else -1
    keep = set()
    while end >= 0 and best[end] >= 0:
        keep.add(end)
        end = prev[end]
    return keep


def write_chain(out, header, block):
    out.write(header + '\n')
    out.writelines(block)
    out.write('\n')


def main():
    ap = argparse.ArgumentParser(
        description='Reciprocal intersection + collinearity split, unlocs forced non-collinear.',
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument('target_chain')
    ap.add_argument('query_chain')
    ap.add_argument('out_collinear')
    ap.add_argument('out_noncollinear')
    ap.add_argument('--unloc-chain',
                    help='rbest chains of the unlocalized scaffolds')
    ap.add_argument('--unloc-claimed-out',
                    help='divert unloc chains already covered by the SUPERs here; '
                         'omit to send every unloc chain to the non-collinear output')
    ap.add_argument('--max-claim-overlap', type=float, default=0.5,
                    help='target-span fraction above which an unloc counts as claimed (default 0.5)')
    args = ap.parse_args()

    if not (0.0 < args.max_claim_overlap <= 1.0):
        sys.exit('ERROR: --max-claim-overlap must be in (0, 1]')

    target_ids = chain_ids(args.target_chain)
    reciprocal = target_ids & chain_ids(args.query_chain)

    # Group the reciprocal chains by chromosome pair, keeping T2T-as-target
    # coordinates (so the ordering check below runs on the T2T axis).
    groups = {}
    for header, block in read_chains(args.target_chain):
        f = header.split()
        if chain_id(f, args.target_chain) not in reciprocal:
            continue
        groups.setdefault((f[2], f[7]), []).append((int(f[10]), header, block))

    collinear = inverted = transposed = stray_unloc = 0
    claims = defaultdict(list)          # tName -> [(tStart, tEnd)] of the SUPERs

    with open(args.out_collinear, 'w') as coll, \
         open(args.out_noncollinear, 'w') as noncoll:

        for chain_list in groups.values():
            chain_list.sort(key=lambda x: x[0])  # walk along the query
            keep = collinear_subset(chain_list)

            for idx, (_, header, block) in enumerate(chain_list):
                f = header.split()
                tStart, tEnd, qStrand = int(f[5]), int(f[6]), f[9]

                if '_unloc_' in f[7]:
                    # Belt and braces: unlocs should never reach this stream,
                    # but if the upstream split ever changes, they stay non-collinear.
                    out = noncoll
                    stray_unloc += 1
                elif idx in keep:
                    out = coll
                    collinear += 1
                elif qStrand == '-':
                    out = noncoll
                    inverted += 1
                else:
                    out = noncoll
                    transposed += 1

                claims[f[2]].append((tStart, tEnd))
                write_chain(out, header, block)

        # ---- unlocs: never collinear ------------------------------------
        unloc_kept = unloc_claimed = 0
        if args.unloc_chain:
            claimed = {t: merge_intervals(v) for t, v in claims.items()}
            cfh = open(args.unloc_claimed_out, 'w') if args.unloc_claimed_out else None
            try:
                for header, block in read_chains(args.unloc_chain):
                    f = header.split()
                    tName, tStart, tEnd = f[2], int(f[5]), int(f[6])
                    span = tEnd - tStart
                    frac = (total_overlap(tStart, tEnd, claimed.get(tName, [])) / span
                            if span > 0 else 0.0)

                    if cfh is not None and frac >= args.max_claim_overlap:
                        write_chain(cfh, header, block)
                        unloc_claimed += 1
                    else:
                        write_chain(noncoll, header, block)
                        unloc_kept += 1
            finally:
                if cfh is not None:
                    cfh.close()

    dropped = len(target_ids) - len(reciprocal)
    print(f'Reciprocal:    {len(reciprocal)} kept, {dropped} dropped '
          f'(not syntenic on both sides)', file=sys.stderr)
    print(f'Collinear:     {collinear}', file=sys.stderr)
    print(f'Non-collinear: {inverted} inverted + {transposed} transposed'
          f' + {unloc_kept} unloc'
          + (f' + {stray_unloc} stray unloc' if stray_unloc else ''),
          file=sys.stderr)
    if args.unloc_chain and args.unloc_claimed_out:
        pct = args.max_claim_overlap * 100
        print(f'Unloc claimed: {unloc_claimed} chains diverted to '
              f'{args.unloc_claimed_out} (>= {pct:.0f}% of the target span is '
              f'already covered by the SUPERs — duplication, not rearrangement)',
              file=sys.stderr)
    elif args.unloc_chain:
        print('Unloc claimed: not separated (--unloc-claimed-out not given)',
              file=sys.stderr)


if __name__ == '__main__':
    main()
